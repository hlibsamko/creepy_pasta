[Unit]
Description=Back up the Creepy Pasta account database
After=local-fs.target
ConditionPathExists=/var/lib/creepy-pasta/accounts.db

[Service]
Type=oneshot
User=root
Group=root
Environment=CREEPY_ACCOUNT_DB_PATH=/var/lib/creepy-pasta/accounts.db
Environment=CREEPY_ACCOUNT_BACKUP_DIR=/var/backups/creepy-pasta
Environment=CREEPY_ACCOUNT_BACKUP_KEEP=14
ExecStart=/usr/bin/python3 /usr/local/lib/creepy-pasta/backup_account_db.py
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/creepy-pasta
ReadWritePaths=/var/backups/creepy-pasta
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
SystemCallArchitectures=native
