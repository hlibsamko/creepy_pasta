[node name="WatcherWarning" parent="Notes" instance=ExtResource("3_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.8, 0.55, 2.8)
note_text = "It only moves inside your attention. Look away before it learns your face."
visual_type = 1
journal_entry_id = "watcher"
journal_fact_index = 1

[node name="MimicWarning" parent="Notes" instance=ExtResource("3_note")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.8, 0.55, 2.65)
note_text = "Door test: a true opening keeps a steady glow. The copy answers with two close pulses."
visual_type = 2
journal_entry_id = "mimic"
journal_fact_index = 3

[node name="DialogueNpcs" type="Node3D" parent="."]

[node name="FinalIntercom" type="Area3D" parent="DialogueNpcs"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.9, 0.72, -3.95)
script = ExtResource("4_dialogue")
speaker_name = "Final Intercom"
dialogue_text = "The copy cannot leave with you.\n\nThe Watcher needs your attention. Walls interrupt it, and brief glances deny it time to take hold.\n\nWrite that down. The house opens its last door only for someone who can name what lives here."
journal_entry_id = "watcher"
journal_fact_index = 3

