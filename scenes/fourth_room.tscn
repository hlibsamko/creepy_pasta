[node name="ThresholdTest" type="Area3D" parent="DialogueNpcs"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 3.35, 0.85, 0.35)
script = ExtResource("4_dialogue")
speaker_name = "Hanging Thread"
dialogue_text = "The thread hangs perfectly still in front of the glowing doorway. There is no draft and no room tone beyond it.\n\nThis is not an opening. It is an imitation waiting for someone to enter."
journal_entry_id = "mimic"
journal_fact_index = 2

