transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -2.65, 0.55, -4.7)
script = ExtResource("3_dialogue")
speaker_name = "Broken Radio"
dialogue_text = "If you can hear this, you are inside the wrong copy of the front room. The house beyond it has no reliable outside.\n\nTwo paper records mark the route to the narrow service door. Do not stop here longer than you have to.\n\nSomeone wrote that the thing in here cannot cross bright light. Treat that as a rumor, not a promise."
journal_entry_id = "listener"
journal_rumor_id = "light_barrier"

