[node name="Elias" parent="DialogueNpcs" instance=ExtResource("2_survivor")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 4.0, 0, 24.0)
speaker_name = "Elias"
dialogue_text = "Mara writes rules as if this place keeps promises. I was a maintenance surveyor before these yellow halls swallowed our crew.\n\nI watched my partner enter a doorway after two quick blinks. The room changed before I could follow, but the light looked calm. I decided the blink meant it had reset safely.\n\nNever touch one immediately. Watch a full light cycle from several steps away first. The steady glow is what I distrust.\n\nWrite that down if you still trust the book. I stopped trusting mine after the rooms changed the ink."
grants_journal = false
journal_entry_id = "mimic"
journal_fact_index = 0
journal_rumor_id = "double_pulse_safe"

