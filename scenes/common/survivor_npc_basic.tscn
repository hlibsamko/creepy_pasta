[node name="Survivor" type="Area3D"]
script = ExtResource("1_dialogue")
speaker_name = "Mara"
dialogue_text = "You heard it running behind you, didn't you? We call that one the Listener. It does not need eyes when the house carries every footstep.\n\nThis journal belonged to my brother Tomas. He trusted a bright-light rule from a radio log and never came back. Keep rumors separate from what you verify yourself.\n\nTake it. If we document every inhabitant, the house may finally show us a door that leads outside."
grants_journal = true
journal_entry_id = "listener"
journal_fact_index = 1

